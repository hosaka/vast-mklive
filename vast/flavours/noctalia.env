# Niri + Noctalia desktop on top of minimal. Runs on the open graphics stack
# (kernel drivers and Mesa).
#
# Sourced by vast/build.sh from the repository root. See vast/README.md for details.

. vast/flavours/minimal.env

TITLE+=" (Noctalia)"

# spelled out instead of patched, a flag missing here makes `chezmoi init` fail
CHEZMOI_FLAGS="desktop=true personal=false development=false nvidia=false"
