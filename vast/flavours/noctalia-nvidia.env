# Niri + Noctalia with proprietary NVIDIA driver, for Turing and newer GPUs (Void's
# nvidia 595 ships the open kernel modules only). Adds about 1G: the driver, and
# gcc plus the kernel headers that dkms needs to build the module.
#
# Sourced by vast/build.sh from the repository root. See vast/README.md for details.

. vast/flavours/noctalia.env

TITLE+=" (NVIDIA)"

# spelled out instead of patched, a flag missing here makes `chezmoi init` fail
CHEZMOI_FLAGS="desktop=true personal=false development=false nvidia=true"
