# Console only: the common profile, no desktop. The base of the other flavours,
# they source this file and change what they need.
#
# See vast/README.md for details.

# Bootloader title of the live ISO, the other flavours append their name
TITLE="Vast Linux"

# Kernel package: `linux` follows Void's stable series, but `linux-lts`,
# `linux-mainline` or `linuxX.Y` also work.
KERNEL=linux

# chezmoi data flags. These answer the prompts in .chezmoi.toml.tmpl and every
# flag set to true enables the package group of the same name in
# .chezmoidata/packages.toml (`common` is always enabled).
#
# Profiles turned off here can be turned on after installing with `just profile on`
#
# Note: All flags prompted by the template must be listed here, otherwise
# `chezmoi init` would fail.
CHEZMOI_FLAGS="desktop=false personal=false development=false nvidia=false"

# Packages that are not managed by chezmoi
EXTRA_PACKAGES=""

# Bootloader of the installed system, limine or grub. The ISO itself always
# boots with grub. limine adds the vast-limine command that installs it after
# void-installer.
BOOTLOADER=limine

# The live user, and the home the dotfiles are rendered in at build time.
# void-installer can create any login.
USERNAME=vast
USERSHELL=/usr/bin/fish

# Groups ticked by default in void-installer's user account menu, on top of
# upstream's defaults. Groups that do not exist on the ISO are not shown.
USERGROUPS="input plugdev socklog storage bluetooth"

KEYMAP=us
LOCALE=en_US.UTF-8

# Remote of the chezmoi source on the installed system: fetch over https so
# `chezmoi update` works without keys, push over ssh
DOTFILES_URL=https://code.hosaka.cc/hosaka/.dotfiles.git
DOTFILES_PUSHURL=ssh://git@git.hosaka.cc/hosaka/.dotfiles
